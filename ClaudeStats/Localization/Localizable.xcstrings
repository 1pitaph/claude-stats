    },
    "Publishes aggregate scores to CloudKit's public database. The app never uploads prompts, paths, session titles, model names, or transcript content." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将汇总分数发布到 CloudKit 的公共数据库。应用永远不会上传提示词、路径、会话标题、模型名称或对话内容。"
          }
        }
      }
    },
    "Publishes privacy-preserving aggregate scores to CloudKit's public database." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将保护隐私的汇总分数发布到 CloudKit 的公共数据库。"
          }
        }
      }
    },
    "Reads commit history of repos you've used Claude Code in (via the `git` command) and compares it with your Claude activity — churn, recent commits, and a usage-vs-commits timeline." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通过 `git` 命令读取你用过 Claude Code 的仓库的提交历史，并与你的 Claude 活动对比 —— 代码改动、最近提交、用量与提交对比时间线。"
          }
        }
      }
    },
    "Reads local commit history for repos used with Claude and correlates code churn with sessions." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "读取与 Claude 一起使用的仓库的本地提交历史，并将代码改动与会话进行关联。"
          }
        }
      }
    },
