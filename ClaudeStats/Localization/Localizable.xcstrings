      }
    },
    "Adds an Activity tab that compares coding surfaces, CLI hosts, and AI activity. Reading Screen Time requires Full Disk Access." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "添加“活动”标签页，对比编码界面、CLI 主机与 AI 活动。读取屏幕使用时间需要完全磁盘访问权限。"
          }
        }
      }
    },
    "Adds an Atoll-backed Dynamic Island surface around the camera notch while keeping existing app entry points." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "围绕摄像头刘海添加基于 Atoll 的灵动岛界面，同时保留现有的应用入口。"
